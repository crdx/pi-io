{
	"name": "@mariozechner/pi-ai",
	"version": "0.62.0",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./anthropic": {
			"types": "./dist/providers/anthropic.d.ts",
			"import": "./dist/providers/anthropic.js"
		},
		"./openai-codex-responses": {
			"types": "./dist/providers/openai-codex-responses.d.ts",
			"import": "./dist/providers/openai-codex-responses.js"
		},
		"./openai-completions": {
			"types": "./dist/providers/openai-completions.d.ts",
			"import": "./dist/providers/openai-completions.js"
		},
		"./openai-responses": {
			"types": "./dist/providers/openai-responses.d.ts",
			"import": "./dist/providers/openai-responses.js"
		},
		"./oauth": {
			"types": "./dist/oauth.d.ts",
			"import": "./dist/oauth.js"
		}
	},
	"bin": {
		"pi-ai": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.73.0",
		"@sinclair/typebox": "^0.34.41",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"openai": "6.26.0",
		"partial-json": "^0.1.7"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"canvas": "^3.2.0",
		"vitest": "3.2.4"
	}
}
