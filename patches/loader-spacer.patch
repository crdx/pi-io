From: anon <anon@system>
Date: Wed, 15 Apr 2026 13:17:37 +0100
Subject: [PATCH] Remove gaps in BorderedLoader

---
 .../dist/modes/interactive/components/bordered-loader.js  | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/modes/interactive/components/bordered-loader.js usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/modes/interactive/components/bordered-loader.js
index 4684971..3c6d732 100644
--- usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/modes/interactive/components/bordered-loader.js
+++ usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/modes/interactive/components/bordered-loader.js
@@ -23,9 +23,15 @@ export class BorderedLoader extends Container {
             this.addChild(new Spacer(1));
             this.addChild(new Text(keyHint("tui.select.cancel", "cancel"), 1, 0));
         }
-        this.addChild(new Spacer(1));
         this.addChild(new DynamicBorder(borderColor));
     }
+    render(width) {
+        const lines = super.render(width);
+        if (lines.length > 1 && lines[1] === '') {
+            lines.splice(1, 1);
+        }
+        return lines;
+    }
     get signal() {
         if (this.cancellable) {
             return this.loader.signal;
