From becb20f3e918aed30653838787b07f2e702fb49e Mon Sep 17 00:00:00 2001
From: anon <anon@system>
Date: Wed, 1 Apr 2026 23:36:15 +0100
Subject: [PATCH] expose expandPromptTemplates option on sendUserMessage

---
 .../@mariozechner/pi-coding-agent/dist/core/agent-session.d.ts  | 1 +
 .../@mariozechner/pi-coding-agent/dist/core/agent-session.js    | 2 +-
 .../pi-coding-agent/dist/core/extensions/types.d.ts             | 2 ++
 3 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/agent-session.d.ts b/usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/agent-session.d.ts
index 87fa2aa..e391e3f 100644
--- usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/agent-session.d.ts
+++ usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/agent-session.d.ts
@@ -348,6 +348,7 @@ export declare class AgentSession {
      */
     sendUserMessage(content: string | (TextContent | ImageContent)[], options?: {
         deliverAs?: "steer" | "followUp";
+        expandPromptTemplates?: boolean;
     }): Promise<void>;
     /**
      * Clear all queued messages and return them.
diff --git a/usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/agent-session.js b/usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/agent-session.js
index c56b556..dc0f3b3 100644
--- usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/agent-session.js
+++ usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/agent-session.js
@@ -958,7 +958,7 @@ export class AgentSession {
         }
         // Use prompt() with expandPromptTemplates: false to skip command handling and template expansion
         await this.prompt(text, {
-            expandPromptTemplates: false,
+            expandPromptTemplates: options?.expandPromptTemplates ?? false,
             streamingBehavior: options?.deliverAs,
             images,
             source: "extension",
diff --git a/usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/extensions/types.d.ts b/usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/extensions/types.d.ts
index 386b279..4c65401 100644
--- usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/extensions/types.d.ts
+++ usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/core/extensions/types.d.ts
@@ -756,6 +756,7 @@ export interface ExtensionAPI {
      */
     sendUserMessage(content: string | (TextContent | ImageContent)[], options?: {
         deliverAs?: "steer" | "followUp";
+        expandPromptTemplates?: boolean;
     }): void;
     /** Append a custom entry to the session for state persistence (not sent to LLM). */
     appendEntry<T = unknown>(customType: string, data?: T): void;
@@ -935,6 +936,7 @@ export type SendMessageHandler = <T = unknown>(message: Pick<CustomMessage<T>, "
 }) => void;
 export type SendUserMessageHandler = (content: string | (TextContent | ImageContent)[], options?: {
     deliverAs?: "steer" | "followUp";
+    expandPromptTemplates?: boolean;
 }) => void;
 export type AppendEntryHandler = <T = unknown>(customType: string, data?: T) => void;
 export type SetSessionNameHandler = (name: string) => void;
-- 
2.53.0
