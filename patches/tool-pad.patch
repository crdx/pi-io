From aaa99e3b5f8198151238f3fadb4b404654bb5d19 Mon Sep 17 00:00:00 2001
From: anon <anon@system>
Date: Fri, 10 Apr 2026 01:47:51 +0100
Subject: [PATCH] Add left padding to tool result boxes

---
 .../dist/modes/interactive/components/tool-execution.js       | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/modes/interactive/components/tool-execution.js b/usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/modes/interactive/components/tool-execution.js
index 974df8b..f4959a1 100644
--- usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/modes/interactive/components/tool-execution.js
+++ usr/lib/node_modules/@mariozechner/pi-coding-agent/dist/modes/interactive/components/tool-execution.js
@@ -39,8 +39,8 @@ export class ToolExecutionComponent extends Container {
         this.addChild(new Spacer(1));
         // Always create both. contentBox is used for tools with renderer-based call/result composition.
         // contentText is reserved for generic fallback rendering when no tool definition exists.
-        this.contentBox = new Box(1, 1, (text) => theme.bg("toolPendingBg", text));
-        this.contentText = new Text("", 1, 1, (text) => theme.bg("toolPendingBg", text));
+        this.contentBox = new Box(2, 1, (text) => theme.bg("toolPendingBg", text));
+        this.contentText = new Text("", 2, 1, (text) => theme.bg("toolPendingBg", text));
         if (this.hasRendererDefinition()) {
             this.addChild(this.contentBox);
         }
-- 
2.53.0

