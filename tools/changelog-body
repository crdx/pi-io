#!/bin/bash
set -euo pipefail

TAG="${1:?usage: changelog-body <tag>}"

BODY=$(awk -v tag="$TAG" '
    $0 ~ "^## " tag " " { found=1; next }
    /^## / { found=0 }
    found
' CHANGELOG.md | sed -e '/./,$!d' -e :a -e '/^\s*$/{ $d; N; ba; }')

if [ -z "$BODY" ]; then
    echo "Release $TAG"
else
    echo "$BODY"
fi
